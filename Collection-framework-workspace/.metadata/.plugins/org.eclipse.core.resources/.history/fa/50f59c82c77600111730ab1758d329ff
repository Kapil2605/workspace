package com.employeeQuestion;

import java.util.List;
import java.util.stream.Collectors;

public class SortEmployeeByNameAndSalary {
	public static void main(String[] args) {
		List<Employee>list=EmployeeData.getEmployee();
		List<Employee>result=list.stream().sorted((a,b)->a.getName().compareTo(b.getName())).sorted((a,b)->a.getSalary()-b.getSalary()).collect(Collectors.toList());

		for(Employee emp:result) {
			System.out.println(emp.id+ " "+emp.name+" "+emp.salary+" "+emp.age);
		}
	}
}
