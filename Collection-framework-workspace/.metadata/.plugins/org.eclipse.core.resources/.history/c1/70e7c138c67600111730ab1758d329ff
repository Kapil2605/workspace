package com.employeeQuestion;

import java.util.List;
import java.util.stream.Collectors;

public class SortEmployeeBySalary {

	public static void main(String[] args) {
		List<Employee>list=EmployeeData.getEmployee();
		list.stream().sorted((a,b)->a.getSalary()-b.getSalary()).collect(Collectors.toList());
		//System.out.println(emp.id+ " "+emp.name+" "+emp.salary+" "+emp.age);

	}

}
