package com.employeeQuestion;

import java.util.List;
import java.util.Map;
import java.util.stream.Collectors;

public class GroupEmployeeByAge {

	public static void main(String[] args) {
		List<Employee> list = EmployeeData.getEmployee();
		Map<Object, List<Employee>>result=list.stream().collect(Collectors.groupingBy(s->s.getAge()));
		

		for (Map.Entry<Integer, List<Employee>> entry : result.entrySet()) {

		    System.out.println("Age : " + entry.getKey());

		    for (Employee emp : entry.getValue()) {
		        System.out.println(emp.getId() + " "
		                + emp.getName() + " "
		                + emp.getSalary() + " "
		                + emp.getAge());
		    }

		    System.out.println();
		}
	}

}
